---
import {data, displayName, type Meal, type Mess} from '../data/menu';
interface Props { mess: Mess; meal: Meal; variant?: 'hybrid' }
const {mess,meal,variant}=Astro.props;
const source=data[mess]; const menu=source.meals[meal];
if(!menu) throw new Error(`Unsupported fixture ${mess}/${meal}`);
const sections=menu.sections.length ? menu.sections : [{title:'',kind:'source',items:menu.items}];
---
<section class="mess" id={`${meal}-${mess}`} data-mess={mess} aria-labelledby={`${meal}-${mess}-title`}>
 <header class="mess-head"><h2 id={`${meal}-${mess}-title`}>{source.label}</h2><span class="serving">{variant==='hybrid' && <span class="serving-label">Serving</span>}<time>{menu.time}</time></span></header>
 <p class="state-note" data-state="cached" hidden>Cached menu · update check failed. Menu may have changed.</p>
 <div class="missing" data-state="missing" hidden><h3>Menu couldn’t be retrieved</h3><p>FC2’s source is unavailable. Check the source below; the other menus are unaffected.</p></div>
 <div class="food">{sections.map(section=><div class="food-group">{section.title && <h3 class="category">{section.title}</h3>}<ul class="dishes">{section.items.map(item=><li class="dish" data-original={item}><span>{displayName(item)}</span></li>)}</ul></div>)}</div>
 <footer class="source-meta"><div class="meta-text"><p class="source-note">{mess==='fc1' ? 'Source: 22 Oct · year unknown' : mess==='fc2' ? 'Schedule · 22 Oct 2026' : 'Menu 1 · rotating schedule'}</p><span class="retrieved" data-retrieved={source.checked}>Snapshot check · {source.checked} IST</span></div><a href={source.url} target="_blank" rel="noreferrer" aria-label={`${source.label} menu source, opens in new tab`}>Source <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" /></svg></a></footer>
</section>
