---
import {data, eligible, meals, labels, type Meal, type Direction} from '../data/menu';
import Menu from './Menu.astro';
import '../styles/base.css';
import '../styles/modern.css';
import '../styles/editorial.css';
interface Props { direction: Direction; meal: Meal; automatic?: boolean }
const {direction,meal,automatic=false}=Astro.props;
// Derive demo cutoffs from the captured schedule, not invented time buckets.
const cutoffs=meals.map(m=>({meal:m,endMinutes:Math.max(...eligible(m).map(mess=>{
 const end=data[mess].meals[m]?.time.split('–')[1];
 if(!end || !/^\d{2}:\d{2}$/.test(end)) throw new Error(`Invalid serving time: ${mess}/${m}`);
 const [hour,minute]=end.split(':').map(Number);
 return hour!*60+minute!;
}))}));
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content={direction==='modern'?'#F2F4F3':'#F4F0CF'}/><meta name="robots" content="noindex"/><title>Mess menus · {labels[meal]} · {direction==='modern'?'Modern utility':'Editorial utility'}</title><link rel="preload" href={direction==='modern'?'/fonts/geist.woff2':'/fonts/ibm-plex-sans-latin.woff2'} as="font" type="font/woff2" crossorigin/></head>
<body class={direction} data-meal={meal} data-automatic-meal={automatic?'true':undefined} data-meal-cutoffs={automatic?JSON.stringify(cutoffs):undefined}><a class="skip" href="#comparison">Skip to menus</a><div class="app">
<header class="masthead"><div class="brand">{direction==='modern'?'Mess':'The mess'}<span class="brand-dot">.</span></div><span class="place">MIT Manipal</span></header>
<div class="date-line"><span class="snapshot-label">Snapshot</span><time datetime="2026-10-22"><span class="day-long">Thursday</span><span class="day-short">Thu</span>, 22 October <span class="year">2026</span></time><span class="date-rule" aria-hidden="true"></span></div>
<nav class="meal-nav" aria-label="Meal period"><div class="meal-options" role="tablist" aria-label="Meal period">{meals.map(m=><a href={`/${direction}/${m}/`} class:list={['meal',{'selected':m===meal}]} data-meal={m} id={`tab-${m}`} role="tab" aria-selected={m===meal?'true':'false'} aria-controls={`panel-${m}`} tabindex="0">{labels[m]}</a>)}</div></nav>
<main id="comparison" tabindex="-1">{meals.map(m=><div id={`panel-${m}`} class="meal-panel" role="tabpanel" aria-labelledby={`tab-${m}`} hidden={m!==meal}><div class="comparison-heading"><h1>{labels[m]}</h1><nav aria-label={`Jump to a ${labels[m].toLowerCase()} menu`} class="jump"><span class="jump-label">Jump to</span>{eligible(m).map(mess=><a href={`#${m}-${mess}`} data-jump={mess}>{mess==='sindhi'?'Sindhi':mess.toUpperCase()}</a>)}</nav></div><p class="simulation" hidden>Prototype example · FC1 cached, FC2 unavailable</p><div class="menu-stack">{eligible(m).map(mess=><Menu meal={m} mess={mess}/>)}</div></div>)}</main>
<footer class="app-footer"><p>Menu schedules, not confirmed service.<br/>All serving times are IST.</p><p>Research snapshot · 22 October 2026<br/><a href="/">Compare design directions</a></p></footer>
</div><script>import '../scripts/interactions';</script></body></html>
