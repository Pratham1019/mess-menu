---
import Experience from '../../components/Experience.astro';
import type { Direction } from '../../data/menu';

export function getStaticPaths() {
  return ['modern', 'editorial'].map(direction => ({ params: { direction } }));
}

const direction = Astro.params.direction as Direction;
---
<!-- Lunch is the readable no-JavaScript fallback; the entry selects by IST on load. -->
<Experience direction={direction} meal="lunch" automatic />
