---
import { menus, type Meal, type MessId } from '../data/menu';

interface Props { id: MessId; meal: Meal }
const { id, meal } = Astro.props;
const source = menus[id];
const menu = source.meals[meal];
---

<section class="mess" id={`${meal}-${id}`} aria-labelledby={`${meal}-${id}-heading`} data-mess={id}>
  <header class="mess-header">
    <h2 id={`${meal}-${id}-heading`}>{source.label}</h2>
    <p class="serving-time" aria-label={`Serving time ${menu.time} IST`}>{menu.time}<span class="sr-only"> IST</span></p>
  </header>
  <p class:list={['schedule-note', { 'hide-when-mixed': id === 'fc2' }]}>{source.dateNote}</p>
  {id === 'fc2' && <p class="schedule-note only-mixed" hidden>Source unavailable</p>}
  {id === 'fc1' && (
    <p class="source-warning only-mixed" hidden>
      <strong>Saved menu.</strong> Refresh unavailable; check the source before you go.
    </p>
  )}
  {id === 'fc2' && (
    <div class="unavailable only-mixed" hidden>
      <h3>Menu unavailable</h3>
      <p>FC2 could not be reached. Check the source or try again later.</p>
    </div>
  )}
  <div class:list={['dishes', { 'hide-when-mixed': id === 'fc2' }]}>
    {menu.sections.length > 0 ? (
      menu.sections.map((section) => (
        <div class="dish-category">
          <h3>{section.title}</h3>
          <ul>{section.items.map((name) => <li>{name}</li>)}</ul>
        </div>
      ))
    ) : (
      <ul>{menu.items.map((name) => <li>{name}</li>)}</ul>
    )}
  </div>
  <footer class="source-line">
    <span class:list={{ 'hide-when-mixed': id === 'fc2' }}>Checked <time datetime={`2026-10-22T${source.checked}:00+05:30`}>{source.checked}</time> IST</span>
    {id === 'fc2' && <span class="only-mixed" hidden>No saved menu</span>}
    <a href={source.url} target="_blank" rel="noreferrer" aria-label={`View ${source.label} source (opens in a new tab)`}>Source</a>
  </footer>
</section>
