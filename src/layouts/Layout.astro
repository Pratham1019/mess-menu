---
import '../styles/base.css';
import '../styles/site.css';
interface Props { title: string; admin?: boolean }
const { title, admin = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F3E9" />
    <meta name="description" content="Today's FC1, FC2 and Sindhi mess menus at MIT Manipal. Compare breakfast, lunch, snacks and dinner." />
    {admin && <meta name="robots" content="noindex, nofollow" />}
    <title>{title} · The mess</title>
    <link rel="preload" href="/fonts/ibm-plex-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={['site', { admin }]}>
    <a class="skip" href={admin ? '#editor' : '#comparison'}>Skip to {admin ? 'content' : 'menus'}</a>
    <div class="app">
      <header class="masthead"><a href="/" class="brand" aria-label="The mess home">The mess<span>.</span></a><span class="place">MIT Manipal</span></header>
      <slot />
    </div>
  </body>
</html>
